# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth v5 — сгенерировать: npx auth secret (или openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
AUTH_TRUST_HOST=true

# Claude API — ключ для анализа документов (опционально; без него используется stub)
ANTHROPIC_API_KEY=

# Vercel Blob — хранилище загруженных документов (шаг 2). Создать Blob store в
# Vercel → Storage → Blob; токен нужен и локально, и в проде (иначе загрузка не работает).
BLOB_READ_WRITE_TOKEN=

# SMTP Zoho для писем подтверждения e-mail (регистрация). app-specific пароль:
# Zoho Mail → Settings → Security → App Passwords, для info@biseeth.md.
# Если ОБЕ переменные пустые — письма не шлются, ссылка логируется в консоль
# ([DEV] Verification link: ...), удобно для локального теста.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# MConnect connector (Verificare imobil → GetRealEstate). Значения в .env.local (локально) / Vercel env (прод).
# CONNECTOR_AUTH_TOKEN = bearer-токен коннектора (тот же, что в /opt/mconnect-connector/.env на VPS).
CONNECTOR_URL=https://connector.imoghid.md/get-real-estate
CONNECTOR_AUTH_TOKEN=
