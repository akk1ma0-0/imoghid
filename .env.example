# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth v5 — сгенерировать: npx auth secret (или openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
AUTH_TRUST_HOST=true

# Claude API — ключ для анализа документов (опционально; без него используется stub)
ANTHROPIC_API_KEY=

# Vercel Blob — хранилище загруженных документов (шаг 2). Создать Blob store в
# Vercel → Storage → Blob; токен нужен и локально, и в проде (иначе загрузка не работает).
BLOB_READ_WRITE_TOKEN=

# SMTP Zoho для писем подтверждения e-mail (регистрация). app-specific пароль:
# Zoho Mail → Settings → Security → App Passwords, для info@biseeth.md.
# Если ОБЕ переменные пустые — письма не шлются, ссылка логируется в консоль
# ([DEV] Verification link: ...), удобно для локального теста.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# MConnect connector (Verificare imobil → GetRealEstate). Значения в .env.local (локально) / Vercel env (прод).
# CONNECTOR_AUTH_TOKEN = bearer-токен коннектора (тот же, что в /opt/mconnect-connector/.env на VPS).
CONNECTOR_URL=https://connector.imoghid.md/get-real-estate
CONNECTOR_AUTH_TOKEN=

# VictoriaBank e-Gateway. ⚠️ TEST endpoint по умолчанию (ecomt.victoriabank.md), не боевой.
VB_TERMINAL=
VB_MERCHANT=
VB_GATEWAY_URL=https://ecomt.victoriabank.md/cgi-bin/cgi_link
VB_MERCH_NAME="BlackSpace Tech SRL"
VB_MERCH_URL=https://imoghid.md
#
# Ключи. Приоритет: путь к файлу (localhost) → содержимое из env (Vercel/serverless).
# Localhost: указать *_PATH на файлы ВНЕ репозитория (приватный — chmod 600, не коммитить).
MERCHANT_PRIVATE_KEY_PATH=
VB_BANK_PUBLIC_KEY_PATH=
# Vercel: вставить ПОЛНОЕ содержимое PEM (с BEGIN/END и переносами) как значение env,
# оба Sensitive. Экранированные "\n" тоже поддерживаются (нормализуются в коде).
MERCHANT_PRIVATE_KEY=
VICTORIA_PUB_KEY=

# Waitlist-режим перед публичным запуском: true → страница «ждите приглашение» вместо тарифов; false → тарифы
WAITLIST_MODE=false

# Секрет Vercel Cron (проверка истёкших планов). На Vercel задать в Production env.
CRON_SECRET=

# bcrypt-хэш пароля подтверждения удаления аккаунта (админка). Хэшируй пароль, не храни plaintext.
ADMIN_DELETE_CONFIRM_HASH=
