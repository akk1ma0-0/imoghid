diff -ruN -x node_modules -x certs -x *.mock-backup -x ws-test.js -x package-lock.json -x logs a/test/parse-body.test.js b/test/parse-body.test.js
--- a/test/parse-body.test.js	1970-01-01 03:00:00
+++ b/test/parse-body.test.js	2026-11-17 15:33:05
@@ -0,0 +1,38 @@
+"use strict";
+// node --test test/   (без сети и без сертификатов: проверяется только разбор ответа и очередь)
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { DOMParser } = require("@xmldom/xmldom");
+const { parseBody } = require("../mconnect");
+
+const wrap = (inner) =>
+  `<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"><s:Body><RealEstate><CadastralNumber>0100109.159.02.001</CadastralNumber><Area>58.40</Area>${inner}</RealEstate></s:Body></s:Envelope>`;
+const parse = (inner) => parseBody(new DOMParser().parseFromString(wrap(inner), "text/xml"));
+
+test("Rights отсутствует → Rights [], RightsPresent false", () => {
+  const r = parse("");
+  assert.deepEqual(r.Rights, []);
+  assert.equal(r.RightsPresent, false);
+});
+test("Rights есть, но без Right → Rights [], RightsPresent true", () => {
+  const r = parse("<Rights/>");
+  assert.deepEqual(r.Rights, []);
+  assert.equal(r.RightsPresent, true);
+});
+test("Right без признака → null (а не false)", () => {
+  const r = parse("<Rights><Right><HasInterdictions>false</HasInterdictions><Quota>1/1</Quota></Right></Rights>");
+  assert.equal(r.Rights[0].HasInterdictions, false);
+  assert.equal(r.Rights[0].HasNotations, null);
+  assert.equal(r.Rights[0].HasOtherRights, null);
+});
+test("пустой/нераспознанный элемент признака → null", () => {
+  const r = parse("<Rights><Right><HasInterdictions/><HasNotations>?</HasNotations><HasOtherRights>true</HasOtherRights></Right></Rights>");
+  assert.equal(r.Rights[0].HasInterdictions, null);
+  assert.equal(r.Rights[0].HasNotations, null);
+  assert.equal(r.Rights[0].HasOtherRights, true);
+});
+test("полный Right → true/false как есть", () => {
+  const r = parse("<Rights><Right><HasInterdictions>true</HasInterdictions><HasNotations>false</HasNotations><HasOtherRights>False</HasOtherRights><Quota>1/2</Quota></Right></Rights>");
+  assert.deepEqual(r.Rights[0], { HasInterdictions: true, Quota: "1/2", HasNotations: false, HasOtherRights: false });
+  assert.equal(r.RightsPresent, true);
+});
diff -ruN -x node_modules -x certs -x *.mock-backup -x ws-test.js -x package-lock.json -x logs a/test/cad-re.test.js b/test/cad-re.test.js
--- a/test/cad-re.test.js	1970-01-01 03:00:00
+++ b/test/cad-re.test.js	2026-11-24 12:00:00
@@ -0,0 +1,37 @@
+"use strict";
+// node --test test/   (без сети и сертификатов: проверяется regex CAD_RE, прочитанный из server.js как есть)
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const src = fs.readFileSync(path.join(__dirname, "..", "server.js"), "utf8");
+const m = src.match(/^const CAD_RE = (\/.*\/);$/m);
+assert.ok(m, "CAD_RE не найден в server.js");
+const CAD_RE = new RegExp(m[1].slice(1, -1));
+
+test("принимаются номера с 3- и 4-значными сегментами", () => {
+  for (const ok of [
+    "0100109",
+    "0100109.159",
+    "0100109.159.02",
+    "0100109.159.02.001",
+    "0100109.128.01.143",
+    "0100225.041.0212",
+    "0100418.027.0094",
+    "0100109.1590.0212.0013",
+  ]) assert.equal(CAD_RE.test(ok), true, ok);
+});
+test("отклоняются неверные форматы", () => {
+  for (const bad of [
+    "",
+    "0100109.1",
+    "100109.159",
+    "0100109..02",
+    "0100109.159.02.001.001",
+    "0100109.159.0",
+    "0100109.159.02.0",
+    "01001A9.159",
+    "0100109.159.02.001 ",
+  ]) assert.equal(CAD_RE.test(bad), false, bad);
+});
